{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {

    "Routes": {
      "supportflow-route": {
        "ClusterId": "supportflow-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "supportflow-cluster": {
        "LoadBalancingPolicy": "RoundRobin",

        "Destinations": {
          "supportflow-api-1": {
            "Address": "https://localhost:7224" // supportFlow API instance running on port 7224
          },
          "supportflow-api-2": {
            "Address": "https://localhost:7225" // second SupportFlow API instance
          }
        },

        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyOrPanic",
          "Active": { // Actively checks destination health
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/db-health"
          },

          "Passive": { // monitors failures from actual proxied requests
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },

        "Metadata": {
          "TransportFailureRateHealthPolicy.RateLimit": "0.5"
        }

      }
    }

  }

}
